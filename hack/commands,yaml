Immediate next step: compare TLS on ports 8443 and 9015

First display the runtime Service ports:

kubectl get svc \
  -n goldengate-dev \
  -o custom-columns='NAME:.metadata.name,PORTS:.spec.ports[*].port,TARGETPORTS:.spec.ports[*].targetPort'

Confirm that both runtime Services expose 8443 and 9015.

Then run this safe TLS diagnostic from the monitor pod. It prints only the verification result—no credentials or certificate body:

kubectl exec -i \
  -n goldengate-monitoring \
  deployment/gg-monitor \
  -- python3 - <<'PY'
import socket
import ssl

CA_FILE = "/mnt/secrets-store/ca-chain-pem"

runtimes = [
    (
        "oracle",
        "gg-oracle-payments-01.goldengate-dev.svc.cluster.local",
        "gg-oracle-payments-01.goldengate-dev.adcbmis.local",
    ),
    (
        "postgresql",
        "gg-postgresql-payments-01.goldengate-dev.svc.cluster.local",
        "gg-postgresql-payments-01.goldengate-dev.adcbmis.local",
    ),
]

context = ssl.create_default_context(cafile=CA_FILE)

for runtime, host, server_name in runtimes:
    for port in (8443, 9015):
        try:
            with socket.create_connection((host, port), timeout=5) as raw:
                with context.wrap_socket(
                    raw,
                    server_hostname=server_name,
                ) as tls:
                    print(
                        f"{runtime} port={port}: "
                        f"TLS_OK protocol={tls.version()}"
                    )
        except ssl.SSLCertVerificationError as exc:
            print(
                f"{runtime} port={port}: "
                f"TLS_VERIFY_FAILED "
                f"code={exc.verify_code} "
                f"reason={exc.verify_message}"
            )
        except Exception as exc:
            print(
                f"{runtime} port={port}: "
                f"{type(exc).__name__}"
            )
PY

