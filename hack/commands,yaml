Optional listener inspection

This does not expose credentials:

kubectl exec \
  -n goldengate-dev \
  gg-oracle-payments-01-0 \
  -- sh -c '
    echo "Processes:";
    ps -ef | grep -Ei "pms|metric" | grep -v grep || true;

    echo "Listening ports:";
    if command -v ss >/dev/null 2>&1; then
      ss -lntup | grep -E ":8443|:9015" || true;
    elif command -v netstat >/dev/null 2>&1; then
      netstat -lntup 2>/dev/null | grep -E ":8443|:9015" || true;
    else
      echo "ss/netstat unavailable";
    fi
  '

