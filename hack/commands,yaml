kubectl exec -i \
  -n goldengate-monitoring \
  deployment/gg-monitor \
  -- python3 - <<'PY'
from pathlib import Path
import collector

probe = Path("/app/tools/gg_api_contract_probe.py").read_text(
    encoding="utf-8"
)

markers = [
    "MAX_RESPONSE_BYTES",
    "MAX_TOP_LEVEL_KEYS",
    "MAX_RESPONSE_KEYS",
    "MAX_KEY_LENGTH",
    "collectionsTruncated",
    "topLevelKeysTruncated",
    "responseKeysTruncated",
    "read(MAX_RESPONSE_BYTES + 1)",
]

for marker in markers:
    print(f"{marker}={marker in probe}")

print(f"collector_logger={collector.logger.name}")
PY