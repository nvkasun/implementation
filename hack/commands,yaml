kubectl exec -i \
  -n goldengate-monitoring \
  deployment/gg-monitor \
  -- python3 - <<'PY'
import http.client
import json

targets = [
    (
        "gg-oracle-payments-01",
        "gg-oracle-payments-01.goldengate-dev.svc.cluster.local",
    ),
    (
        "gg-postgresql-payments-01",
        "gg-postgresql-payments-01.goldengate-dev.svc.cluster.local",
    ),
]

paths = [
    "/services/v2/mpoints/processes",
    "/services/v2/monitoring/statusChanges",
    "/services/v2/metrics",
]

for deployment, host in targets:
    for path in paths:
        result = {
            "deployment": deployment,
            "port": 9015,
            "schemeTested": "http",
            "path": path,
        }

        try:
            connection = http.client.HTTPConnection(
                host,
                9015,
                timeout=5,
            )

            connection.request(
                "GET",
                path,
                headers={
                    "Accept": "application/json",
                    "User-Agent": "gg-pms-contract-check/1",
                },
            )

            response = connection.getresponse()

            result["httpStatus"] = response.status
            result["contentType"] = (
                response.getheader("Content-Type") or ""
            ).split(";", 1)[0]

            # Do not print or retain the response body.
            response.read(1)
            connection.close()

        except Exception as exc:
            result["errorType"] = type(exc).__name__

        print(json.dumps(result, sort_keys=True))
