2. Test the new collection summarizer inside the pod

This uses only synthetic data and does not contact GoldenGate:

kubectl exec -i \
  -n goldengate-monitoring \
  deployment/gg-monitor \
  -- python3 - <<'PY'
import importlib.util
import json
from pathlib import Path

path = Path("/app/tools/gg_api_contract_probe.py")
spec = importlib.util.spec_from_file_location("probe", path)
probe = importlib.util.module_from_spec(spec)
spec.loader.exec_module(probe)

payload = {
    "response": {
        "processes": [
            {
                "name": "SYNTHETIC_PROCESS_VALUE",
                "lag": 10,
                "details": {"hidden": "value"},
            }
        ],
        "statusChange": [],
    }
}

result = probe.summarize_json(payload)
print(json.dumps(result, indent=2, sort_keys=True))
PY

Expected important section:

"collections": {
  "processes": {
