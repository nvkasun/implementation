{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowPutContainerInsightsMetricData",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricData"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "ContainerInsights"
        }
      }
    },
    {
      "Sid": "AllowWriteContainerInsightsPerformanceLogEvents",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:DescribeLogStreams",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:eu-west-1:668311715351:log-group:/aws/containerinsights/gg-poc-dev/performance:*"
    },
    {
      "Sid": "AllowDescribeLogGroupsForContainerInsightsDiscovery",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowEc2MetadataRequiredByCloudWatchAgent",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeTags",
        "ec2:DescribeVolumes"
      ],
      "Resource": "*"
    }
  ]
}
